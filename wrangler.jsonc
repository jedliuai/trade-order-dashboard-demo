{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trade-order-dashboard-demo",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "deskdemo.jedliuai.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./.wrangler/trial-ui",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "BUSINESS",
      "service": "deskdemo-business"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deskdemo-workspaces",
      "database_id": "089be710-0c4d-4322-a69e-78b5691e181e",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "24061",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SIGNUP_LIMIT",
      "namespace_id": "24062",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
